<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: packaging/macos/package.sh substitutes @VERSION@ (full, e.g. 0.2.0-rc.1),
     @SHORT_VERSION@ (numeric X.Y.Z) and @BUILD_SHA@. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>Jilo Studio</string>
  <key>CFBundleName</key>
  <string>Jilo Studio</string>
  <key>CFBundleExecutable</key>
  <string>Jilo Studio</string>
  <key>CFBundleIdentifier</key>
  <string>com.rustamguloff.jilostudio</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>FilmCraftVersion</key>
  <string>@VERSION@</string>
  <key>FilmCraftBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>JiloStudio</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.video</string>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in package.sh (and .cargo/config.toml). Our build
       supports Apple silicon on macOS 15 Sequoia and later. -->
  <key>LSMinimumSystemVersion</key>
  <string>15.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <!-- Voice-over recording (Audio Track Mixer ▸ Record) opens the microphone. Without this key
       macOS terminates the app on the first microphone access. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Jilo Studio records voice-over from your microphone when you arm a track and press Record.</string>
  <key>NSHumanReadableCopyright</key>
  <string>© 2026 Rustam Gulov. Based on FilmCraft © the FilmCraft authors. MIT OR Apache-2.0.</string>

  <!-- What Jilo Studio opens from Finder (double-click, Open With, a drop on the Dock icon): its
       projects as their owner, video / audio / images as an alternative (they are imported). -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Jilo Studio Project</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>CFBundleTypeIconFile</key>
      <string>JiloStudio</string>
      <key>LSItemContentTypes</key>
      <array><string>com.rustamguloff.jilostudio.project</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Media</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.movie</string>
        <string>public.audio</string>
        <string>public.image</string>
        <string>public.mpeg-2-transport-stream</string>
        <string>org.matroska.mkv</string>
      </array>
    </dict>
  </array>

  <!-- Filmcraft's own format. -->
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>com.rustamguloff.jilostudio.project</string>
      <key>UTTypeDescription</key>
      <string>Jilo Studio Project</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.json</string>
      </array>
      <key>UTTypeIconFile</key>
      <string>JiloStudio</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>fcproj</string></array>
        <key>public.mime-type</key>
        <array><string>application/x-filmcraft</string></array>
      </dict>
    </dict>
  </array>

</dict>
</plist>
